{
  "name": "sensor-dashboard",
  "version": "1.0.0",
  "description": "Location-based sensor monitoring dashboard",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "mqtt": "^5.10.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
